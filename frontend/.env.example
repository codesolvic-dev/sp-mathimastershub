# Copy to .env for local dev. On Vercel, add these in Project → Settings → Environment Variables.
# Root Directory on Vercel must be: frontend

# Local dev: first URL for localhost, second for production build
VITE_API_URLS=http://localhost:3000/api,https://spbuilder-db.vercel.app/api
VITE_API_URL=https://spbuilder-db.vercel.app/api

# Public site + API shown in Admin → Settings → Device Config (QR)
VITE_PUBLIC_SITE_URL=https://spbuilder-sp.vercel.app
VITE_PUBLIC_API_URL=https://spbuilder-db.vercel.app/api

# Pusher (public key + cluster — must match backend)
VITE_PUSHER_KEY=your_pusher_key
VITE_PUSHER_CLUSTER=ap2
